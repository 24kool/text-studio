@baseUrl = http://127.0.0.1:8000

### Health Check
GET {{baseUrl}}/api/v1/health

### Get Available Providers
GET {{baseUrl}}/api/v1/providers

### Test Root Endpoint
GET {{baseUrl}}/

### Transform Text - Tone Change (Casual)
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello. Thank you for attending today's meeting.",
    "transformation_type": "tone",
    "tone_x": -50,
    "tone_y": 0,
    "ai_provider": "gemini"
}

### Transform Text - 2D Tone Control (Formal + Concise)
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello. Thank you for attending today's meeting.",
    "transformation_type": "tone",
    "tone_x": 30,
    "tone_y": 60,
    "ai_provider": "gemini"
}

### Transform Text - 2D Tone Control (Casual + Elaborate)
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello. Thank you for attending today's meeting.",
    "transformation_type": "tone",
    "tone_x": -30,
    "tone_y": -60,
    "ai_provider": "gemini"
}

### Transform Text - 2D Tone Control (Very Formal + Very Concise)
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello. Thank you for attending today's meeting.",
    "transformation_type": "tone",
    "tone_x": 80,
    "tone_y": 80,
    "ai_provider": "gemini"
}

### Transform Text - 2D Tone Control (Neutral - No Change)
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello. Thank you for attending today's meeting.",
    "transformation_type": "tone",
    "tone_x": 0,
    "tone_y": 0,
    "ai_provider": "gemini"
}

### Transform Text - Format Change
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "The project has been completed successfully. Thank you for all team members' hard work.",
    "transformation_type": "format",
    "format": "email",
    "ai_provider": "gemini"
}

### Transform Text - Language Translation
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Hello, how are you today?",
    "transformation_type": "language",
    "target_language": "ko",
    "ai_provider": "gemini"
}

### Transform Text - Length Adjustment
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "Artificial intelligence is a very important technology in modern society.",
    "transformation_type": "length",
    "length": "expand",
    "ai_provider": "gemini"
}

### Transform Text - Custom Instruction with 2D Tone
POST {{baseUrl}}/api/v1/transform
Content-Type: application/json

{
    "text": "The weather is nice today.",
    "transformation_type": "tone",
    "tone_x": 60,
    "tone_y": 30,
    "custom_instruction": "Please write in business email format",
    "ai_provider": "gemini"
}

### Upload and Transform - Text File (DISABLED - OCR feature not yet implemented)
# POST {{baseUrl}}/api/v1/upload-and-transform
# Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
#
# ------WebKitFormBoundary7MA4YWxkTrZu0gW
# Content-Disposition: form-data; name="file"; filename="test.txt"
# Content-Type: text/plain
#
# Hello. This is a test file.
# ------WebKitFormBoundary7MA4YWxkTrZu0gW
# Content-Disposition: form-data; name="transformation_type"
#
# tone
# ------WebKitFormBoundary7MA4YWxkTrZu0gW
# Content-Disposition: form-data; name="tone_x"
#
# 60
# ------WebKitFormBoundary7MA4YWxkTrZu0gW
# Content-Disposition: form-data; name="tone_y"
#
# 0
# ------WebKitFormBoundary7MA4YWxkTrZu0gW
